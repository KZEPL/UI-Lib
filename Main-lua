-- ============================================================
--  DRAGGING (WHOLE WINDOW - Mobile friendly)
-- ============================================================
local dragging = false
local dragStart = nil
local startPos = nil
local noDrag = {}
local function markNoDrag(gui) noDrag[gui] = true end

local function isInside(obj, ancestor)
	local node = obj
	while node do
		if node == ancestor then return true end
		node = node.Parent
	end
	return false
end

-- Make the entire MainWindow draggable (except interactive elements)
MainWindow.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		-- Check if click is on an interactive element (button, slider, dropdown, textbox)
		local objs = playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
		for _, obj in ipairs(objs) do
			local node = obj
			while node do
				if noDrag[node] then
					return -- Don't drag if clicking on interactive element
				end
				node = node.Parent
			end
		end
		dragging = true
		dragStart = input.Position
		startPos = MainWindow.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainWindow.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)


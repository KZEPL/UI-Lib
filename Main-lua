local navbarCollapsed = true
local currentNavbarWidth = NAV_WIDTH
local currentIndicatorY = 87
local targetIndicatorY = 87
local tabs = {}
local activeTabId = nil

local function switchTab(id)
	if activeTabId == id then return end
	for tabId, tabData in pairs(tabs) do
		if tabId == id then
			tabData.Icon.ImageColor3 = THEME.Text
			tabData.Text.TextColor3 = THEME.Text
			tabData.Container.Visible = true
			tabData.Container.GroupTransparency = 1
			TweenService:Create(tabData.Container, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
			targetIndicatorY = tabData.Button.Position.Y.Offset
			TabIndicator.Visible = true
		else
			tabData.Icon.ImageColor3 = THEME.TextDisabled
			tabData.Text.TextColor3 = THEME.TextDisabled
			if tabData.Container.Visible then
				local c = tabData.Container
				TweenService:Create(c, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1}):Play()
				task.delay(0.24, function()
					if c and c.Parent and tabs[activeTabId] and tabs[activeTabId].Container ~= c then
						c.Visible = false
					end
				end)
			end
		end
	end
	activeTabId = id
end

RunService.RenderStepped:Connect(function()
	local tW = navbarCollapsed and NAV_WIDTH or (isMobile and 100 or 150)
	currentNavbarWidth = currentNavbarWidth + (tW - currentNavbarWidth) * 0.15
	Navbar.Size = UDim2.new(0, currentNavbarWidth, 1, 0)
	local tA = navbarCollapsed and 0 or 0.7
	ContentArea.GroupTransparency = ContentArea.GroupTransparency + (tA - ContentArea.GroupTransparency) * 0.15
	BlockInputFrame.Visible = not navbarCollapsed
	currentIndicatorY = currentIndicatorY + (targetIndicatorY - currentIndicatorY) * 0.15
	TabIndicator.Position = UDim2.new(1, -2, 0, currentIndicatorY)
	local tR = navbarCollapsed and 0 or 180
	CollapseButton.Rotation = CollapseButton.Rotation + (tR - CollapseButton.Rotation) * 0.15
	local contentAlpha = math.clamp((currentNavbarWidth - NAV_WIDTH) / 100, 0, 1)
	for _, tabData in pairs(tabs) do
		tabData.Text.TextTransparency = 1 - contentAlpha
	end
end)

